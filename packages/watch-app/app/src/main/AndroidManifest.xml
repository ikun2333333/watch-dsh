<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The watch reaches the PC over the network, either through a relay on the
         internet or directly over Wi-Fi when both are on the same network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed to hold a high-performance Wi-Fi lock while a link is live. A
         watch otherwise suspends its radio seconds into an idle connection and
         the socket dies mid-conversation. Holding a Wi-Fi lock requires
         WAKE_LOCK as well as CHANGE_WIFI_STATE; neither wakes the screen or keeps
         the CPU awake on its own. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Needed to receive discovery replies. Android's Wi-Fi stack drops broadcast
         and multicast traffic unless a MulticastLock is held, so without this the
         probe goes out and the answer never reaches the socket: the scan looks
         like it did nothing at all. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Voice input has two paths. The default goes through the system input
         activity, which transcribes in the platform's own process and needs no
         permission here. The alternative records on the watch and streams the
         audio to a recognizer the app controls, which is the only way to make
         results appear while the user is still speaking - and that needs the
         microphone. It is requested at the moment it is used, not at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The link is kept alive by a foreground service, because that is the only
         thing Android guarantees will not be frozen while the screen is off. A
         frozen process cannot answer the WebSocket ping, so the socket was cut
         about twenty seconds after the screen went dark, and the reconnect it
         scheduled never ran either. FOREGROUND_SERVICE_DATA_SYNC is required from
         API 34 for the type used; POST_NOTIFICATIONS is required from API 33 to
         show the ongoing notification that a foreground service must have. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app is useful exactly when a PC is reachable, so it is not required
         to run on a watch without a network of its own. -->
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchDsh">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Declares this as a standalone Wear app so it installs and runs
             without a companion phone app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <meta-data
            android:name="com.google.android.wearable.notificationBridge"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WatchDsh">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started while the app means to be connected, stopped when it does not.
             `stopWithTask` so closing the app takes the notification with it rather
             than leaving an orphan the user cannot dismiss. -->
        <service
            android:name=".net.LinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="true" />
    </application>

</manifest>
